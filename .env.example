# INTEYLO — variables d'environnement (copier en .env ; ne jamais committer .env).
# Aucune valeur ci-dessous n'est un vrai secret : remplacez chaque mot de passe.

# --- Base de données (docker compose de développement) ---
POSTGRES_PASSWORD=change-moi-superutilisateur
INTEYLO_OWNER_PASSWORD=change-moi-proprietaire
INTEYLO_APP_PASSWORD=change-moi-applicatif
INTEYLO_DB_NAME=inteylo

# --- API (préfixe INTEYLO_ ; chaque variable accepte aussi la forme _FILE) ---
# development | test | staging | production
INTEYLO_ENVIRONMENT=development
# URL du rôle applicatif (soumis à la RLS). Hors Docker uniquement ; compose la construit seul.
# INTEYLO_DATABASE_URL=postgresql+psycopg://inteylo_app:<mot-de-passe>@127.0.0.1:5432/inteylo
# URL du rôle propriétaire, pour les migrations Alembic uniquement.
# INTEYLO_MIGRATION_DATABASE_URL=postgresql+psycopg://inteylo_owner:<mot-de-passe>@127.0.0.1:5432/inteylo
INTEYLO_APP_DB_ROLE=inteylo_app
INTEYLO_COOKIE_SECURE=false
INTEYLO_PUBLIC_WEB_URL=http://localhost:3000
INTEYLO_LOG_LEVEL=INFO
INTEYLO_SESSION_TTL_HOURS=168
INTEYLO_INVITATION_TTL_HOURS=72
INTEYLO_LOGIN_MAX_ATTEMPTS=10
INTEYLO_LOGIN_WINDOW_SECONDS=900
# Origines autorisées (JSON) si le frontend est servi sur un autre domaine que l'API.
# INTEYLO_CORS_ORIGINS=["https://app.exemple.fr"]

# --- Frontend ---
# Relais /api/* -> API quand aucun reverse proxy n'est présent (développement, tests E2E).
API_INTERNAL_URL=http://127.0.0.1:8000

# --- Production (docker-compose.prod.yml) ---
# INTEYLO_DOMAIN=app.exemple.fr
# INTEYLO_ACME_EMAIL=exploitation@exemple.fr
# INTEYLO_IMAGE_PREFIX=ghcr.io/<compte>/inteylo
# INTEYLO_VERSION=<sha-du-commit>
